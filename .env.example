# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# API key for protecting the REST API (min 32 chars)
API_KEY=your-super-secret-api-key-min-32-chars-here

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sap_triage
# Separate DB for integration tests (never use DATABASE_URL in tests)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/sap_triage_test

# ─── SAP Integration ─────────────────────────────────────────────────────────
# "sandbox" serves realistic mock data with the same OData V4 schema
# "live"    connects to real SAP BTP via OAuth2
SAP_MODE=sandbox

# Required only when SAP_MODE=live:
SAP_BTP_BASE_URL=
SAP_BTP_CLIENT_ID=
SAP_BTP_CLIENT_SECRET=
SAP_BTP_TOKEN_URL=

# ─── AI Provider ─────────────────────────────────────────────────────────────
# "claude"  uses Anthropic Claude API (recommended)
# "openai"  uses OpenAI API (swap-in provider)
AI_PROVIDER=claude

ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ─── n8n Webhook ─────────────────────────────────────────────────────────────
# Shared secret for validating n8n webhook calls (min 16 chars)
N8N_WEBHOOK_SECRET=your-webhook-secret-here

# ─── Frontend (apps/web/.env) ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
# Mirrors backend SAP_MODE — controls sandbox banner visibility
VITE_SAP_MODE=sandbox
