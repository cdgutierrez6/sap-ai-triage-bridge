{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@sap-triage/shared": ["../../packages/shared/src/index.ts"],
      // Resolve directly to the generated Prisma client (outside node_modules).
      // This directory is NOT excluded by tsconfig "exclude": ["node_modules"],
      // so tsc reads the real generated model types without following pnpm symlinks.
      // Matches schema.prisma `output = "../src/__generated__/prisma"`.
      "@prisma/client": ["./src/__generated__/prisma"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
