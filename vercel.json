{
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/api/src/index.ts" }
  ],
  "functions": {
    "apps/api/src/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production",
    "SAP_MODE": "sandbox"
  }
}
